# Server
PORT=8000
DEV_MODE=true

# Auth
JWT_SECRET=prostaff-dev-secret-change-me

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=prostaff
DB_PASSWORD=prostaff
DB_NAME=prostaff
DB_SSLMODE=disable

# Admin seed account
ADMIN_EMAIL=admin@prostaff.uz
ADMIN_PASSWORD=admin123
ADMIN_PHONE=998900000000

# Atmos payment gateway.
#
# Leave ATMOS_BASE_URL empty and payments stay in development mode: DEV_MODE
# credits a top-up instantly and grants a subscription instantly, and with
# DEV_MODE off both are refused rather than pretending to have worked.
#
# The development path runs the same settlement code a real callback does — the
# payment row, the months, the notification — so wiring the gateway up later
# changes how the money arrives and nothing about what happens next.
#
# Confirm the two URLs and ATMOS_API_KEY against your own merchant docs — they
# are per-account. ATMOS_API_KEY is the key callbacks are SIGNED with and is a
# different secret from ATMOS_CONSUMER_SECRET.
#
# The callback URL to register in the merchant cabinet is:
#   https://<your-host>/api/v1/payments/atmos/callback
ATMOS_BASE_URL=
ATMOS_CHECKOUT_URL=https://checkout.pays.uz/invoice/get
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
# Only if your account was issued one.
ATMOS_TERMINAL_ID=
ATMOS_API_KEY=
# Deep link Atmos returns the payer's browser to after the invoice page.
ATMOS_REDIRECT_URL=prostaff://wallet

# Eskiz SMS provider
ESKIZ_BASE_URL=
ESKIZ_TOKEN=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# 4546 is Eskiz's shared sender id. Use your own alphanumeric name only after
# it has been approved in my.eskiz.uz, otherwise every message is rejected.
ESKIZ_SENDER=4546

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Business logic
COMMISSION_PERCENT=10
MIN_BALANCE=10000
# Jobs a brand-new worker/firm may accept before the money rules apply. Counted
# per passport series / INN, so re-registering does not hand out another three.
FREE_ORDER_LIMIT=3
# A firm pays by the month, not a commission per job. What it actually pays
# comes off a tariff card (admin -> Sozlamalar -> Tariflar): "1 oy — 100 000",
# "3 oy — 200 000", and so on. These two only seed the starting cards on a fresh
# database and price a counter sale for a term that has no card of its own.
COMPANY_MONTHLY_PRICE=300000
COMPANY_DISCOUNT_PERCENT=0
SUBSCRIPTION_WARN_DAYS=7

# Firebase Cloud Messaging — push that survives the app being closed.
#
# Without this the server falls back to Expo's push service, which hands Android
# a data-only message. That is not a notification: it becomes one only once the
# app's own process picks it up, so it shows while the app is open and shows
# nothing at all once Android has ended the process. Set this and the server
# sends a real notification payload straight to Firebase, which Android renders
# by itself — the behaviour every other messaging app has.
#
# The key: Firebase Console -> Project settings -> Service accounts ->
# Generate new private key. It must belong to the SAME Firebase project as the
# google-services.json bundled in the app (prostaff-cec9e), or Firebase answers
# every send with SenderId mismatch.
#
# Give it as a path, or paste the JSON itself when the host has no filesystem
# for secrets. Escaped \n inside private_key is handled.
FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
#FCM_SERVICE_ACCOUNT_JSON=
