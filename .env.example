# Server
PORT=8000
DEV_MODE=true

# Auth
JWT_SECRET=prostaff-dev-secret-change-me

# Uploaded photos — where the bytes go.
#
# Empty (the default) keeps them inside Postgres as BYTEA. That is right on a
# host whose filesystem is wiped on every deploy, and wrong on a server with a
# disk: every avatar ends up in pg_dump, in the WAL, and in the pages Postgres
# is caching instead of caching orders.
#
# Point it at a directory that survives a restart — under Docker that means a
# volume, not a path inside the container. docker-compose.yml already does this
# (/data/uploads), so leave it alone there.
#
# Turning it on breaks nothing: photos already in the database keep being served
# from it, under the same URLs. UPLOAD_MIGRATE moves them across, once, at
# startup. Postgres does not return the freed pages to the disk on its own —
# after a migration run:  psql -c 'VACUUM FULL files'
UPLOAD_DIR=
UPLOAD_MIGRATE=false
# Cap on one photo. The picker sends about 300 KB at 0.6 quality; the cap is
# what stops a client that forgot to compress from filling the disk. Raise
# Caddy's request_body max_size with it.
MAX_UPLOAD_MB=3

# Delete a job's photos once the job is over (completed, cancelled or expired).
#
# This is what keeps the disk from filling. Order photos are the only thing on
# the platform that grows without a ceiling — six per job, a new job every few
# minutes, and a photo nobody will look at again the moment the work is done. At
# a hundred thousand accounts they are the difference between a server that
# lasts a year and one that lasts a decade.
#
# Profile photos are never touched: avatars, a worker's portfolio, a firm's
# gallery all stay for as long as the account does. The two are told apart by a
# column on the file itself (files.order_id), not by guessing from the URL, so
# there is no case where a cleanup reaches the wrong one.
PURGE_ORDER_PHOTOS=true
# Days to keep a finished job's photos before deleting them. 0 deletes them as
# the job closes.
#
# Worth setting to 3 or 7 if the office ever handles complaints: the photos are
# the only record of what the job actually looked like, and a customer ringing
# up the next day about work they are unhappy with has nothing to show once they
# are gone. The cost is disk — roughly a week of orders' worth.
ORDER_PHOTO_GRACE_DAYS=0

# The domain Caddy gets a TLS certificate for (docker-compose.yml + Caddyfile).
# Point its A record at the server before `docker compose up`.
DOMAIN=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=prostaff
DB_PASSWORD=prostaff
DB_NAME=prostaff
DB_SSLMODE=disable
# How many connections the API may open. Go's own default is unlimited, which on
# a small server is a way to lose the whole machine: every concurrent query
# becomes a Postgres backend process with a work_mem allowance of its own, so a
# traffic spike turns into hundreds of them and the box runs out of memory. With
# a cap the spike queues inside Go instead — slower for a moment, still serving.
#
# Keep it below the server's max_connections (60 in docker-compose.yml), which
# also has to leave room for psql and pg_dump.
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=5

# Admin seed account
ADMIN_EMAIL=admin@prostaff.uz
ADMIN_PASSWORD=admin123
ADMIN_PHONE=998900000000

# Atmos payment gateway.
#
# Leave ATMOS_BASE_URL empty and payments stay in development mode: DEV_MODE
# credits a top-up instantly and grants a subscription instantly, and with
# DEV_MODE off both are refused rather than pretending to have worked.
#
# The development path runs the same settlement code a real callback does — the
# payment row, the months, the notification — so wiring the gateway up later
# changes how the money arrives and nothing about what happens next.
#
# Confirm the two URLs and ATMOS_API_KEY against your own merchant docs — they
# are per-account. ATMOS_API_KEY is the key callbacks are SIGNED with and is a
# different secret from ATMOS_CONSUMER_SECRET.
#
# The callback URL to register in the merchant cabinet is:
#   https://<your-host>/api/v1/payments/atmos/callback
ATMOS_BASE_URL=
ATMOS_CHECKOUT_URL=https://checkout.pays.uz/invoice/get
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
# Only if your account was issued one.
ATMOS_TERMINAL_ID=
ATMOS_API_KEY=
# Deep link Atmos returns the payer's browser to after the invoice page.
ATMOS_REDIRECT_URL=prostaff://wallet

# Eskiz SMS provider
ESKIZ_BASE_URL=
ESKIZ_TOKEN=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# 4546 is Eskiz's shared sender id. Use your own alphanumeric name only after
# it has been approved in my.eskiz.uz, otherwise every message is rejected.
ESKIZ_SENDER=4546

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Business logic
COMMISSION_PERCENT=10
MIN_BALANCE=10000
# Jobs a brand-new worker/firm may accept before the money rules apply. Counted
# per passport series / INN, so re-registering does not hand out another three.
FREE_ORDER_LIMIT=3
# A firm pays by the month, not a commission per job. What it actually pays
# comes off a tariff card (admin -> Sozlamalar -> Tariflar): "1 oy — 100 000",
# "3 oy — 200 000", and so on. These two only seed the starting cards on a fresh
# database and price a counter sale for a term that has no card of its own.
COMPANY_MONTHLY_PRICE=300000
COMPANY_DISCOUNT_PERCENT=0
SUBSCRIPTION_WARN_DAYS=7

# Firebase Cloud Messaging — push that survives the app being closed.
#
# Without this the server falls back to Expo's push service, which hands Android
# a data-only message. That is not a notification: it becomes one only once the
# app's own process picks it up, so it shows while the app is open and shows
# nothing at all once Android has ended the process. Set this and the server
# sends a real notification payload straight to Firebase, which Android renders
# by itself — the behaviour every other messaging app has.
#
# The key: Firebase Console -> Project settings -> Service accounts ->
# Generate new private key. It must belong to the SAME Firebase project as the
# google-services.json bundled in the app (prostaff-cec9e), or Firebase answers
# every send with SenderId mismatch.
#
# Give it as a path, or paste the JSON itself when the host has no filesystem
# for secrets. Escaped \n inside private_key is handled.
FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
#FCM_SERVICE_ACCOUNT_JSON=
