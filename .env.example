# Server
PORT=8000
DEV_MODE=true

# Auth
JWT_SECRET=prostaff-dev-secret-change-me

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=prostaff
DB_PASSWORD=prostaff
DB_NAME=prostaff
DB_SSLMODE=disable

# Admin seed account
ADMIN_EMAIL=admin@prostaff.uz
ADMIN_PASSWORD=admin123
ADMIN_PHONE=998900000000

# Eskiz SMS provider
ESKIZ_BASE_URL=
ESKIZ_TOKEN=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# 4546 is Eskiz's shared sender id. Use your own alphanumeric name only after
# it has been approved in my.eskiz.uz, otherwise every message is rejected.
ESKIZ_SENDER=4546

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Business logic
COMMISSION_PERCENT=10
MIN_BALANCE=10000
